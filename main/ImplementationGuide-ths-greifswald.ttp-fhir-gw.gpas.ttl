       fhir:name [ fhir:v "anonymizeOriginals" ] ;
       fhir:description [ fhir:v "Anonymisiert eine gegebene Liste von 1-n Originalwerten innerhalb der angegebenen Domäne. Dabei wird der Bezug von Originalwert und Pseudonym dauerhaft únd irreversibel gelöscht." ] ;
